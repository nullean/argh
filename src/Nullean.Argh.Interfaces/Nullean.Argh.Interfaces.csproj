<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Nullean.Argh.Interfaces</AssemblyName>
    <TargetFrameworks>netstandard2.0;net8.0;net11.0</TargetFrameworks>
    <RootNamespace>Nullean.Argh</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\keypair.snk</AssemblyOriginatorKeyFile>
    <PackageId>Nullean.Argh.Interfaces</PackageId>
    <Title>Nullean.Argh.Interfaces - Contracts and attributes</Title>
    <Description>Contracts and attributes for Nullean.Argh CLI (middleware, parsers, registration surfaces). Zero external dependencies.</Description>
    <PackageTags>cli;command-line;attributes;middleware</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Compile Remove="Polyfills/System.Diagnostics.CodeAnalysis.Trimming.cs" />
  </ItemGroup>

</Project>
