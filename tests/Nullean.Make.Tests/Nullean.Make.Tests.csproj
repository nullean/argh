<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TUnit test projects are self-hosting Microsoft.Testing.Platform executables -->
    <OutputType>Exe</OutputType>
    <!-- assertions are AwesomeAssertions; do not bring TUnit's own Assert.That into scope -->
    <TUnitAssertionsImplicitUsings>false</TUnitAssertionsImplicitUsings>
    <!-- TUnit0055: these tests swap Console.Out/Error on purpose to capture CLI output; they run [NotInParallel] -->
    <NoWarn>$(NoWarn);TUnit0055</NoWarn>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Nullean.Make.Tests</AssemblyName>
    <RootNamespace>Nullean.Make.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Target descriptions come from the XML doc file next to the assembly. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nullean.Make\Nullean.Make.csproj" />
    <ProjectReference Include="..\..\src\Nullean.Make.Generator\Nullean.Make.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
