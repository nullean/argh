<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TUnit test projects are self-hosting Microsoft.Testing.Platform executables -->
    <OutputType>Exe</OutputType>
    <!-- assertions are AwesomeAssertions; do not bring TUnit's own Assert.That into scope -->
    <TUnitAssertionsImplicitUsings>false</TUnitAssertionsImplicitUsings>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Nullean.Argh.Generator.Tests</AssemblyName>
    <RootNamespace>Nullean.Argh.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\keypair.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nullean.Argh.Generator\Nullean.Argh.Generator.csproj" />
    <ProjectReference Include="..\..\src\Nullean.Argh.Interfaces\Nullean.Argh.Interfaces.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
