<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TUnit test projects are self-hosting Microsoft.Testing.Platform executables -->
    <OutputType>Exe</OutputType>
    <!-- assertions are AwesomeAssertions; do not bring TUnit's own Assert.That into scope -->
    <TUnitAssertionsImplicitUsings>false</TUnitAssertionsImplicitUsings>
    <!-- TUnit0055: these tests swap Console.Out/Error on purpose to capture CLI output; they run [NotInParallel] -->
    <NoWarn>$(NoWarn);TUnit0055</NoWarn>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Nullean.Argh.Tests</AssemblyName>
    <RootNamespace>Nullean.Argh.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;AGH0035</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nullean.Argh\Nullean.Argh.csproj" />
    <ProjectReference Include="..\..\src\Nullean.Argh.Generator\Nullean.Argh.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    <ProjectReference Include="..\Nullean.Argh.Tests.ReferencedDtos\Nullean.Argh.Tests.ReferencedDtos.csproj" />
    <ProjectReference Include="..\Nullean.Argh.Tests.CliHost\Nullean.Argh.Tests.CliHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyCliHostToTestOutput" AfterTargets="Build">
    <PropertyGroup>
      <_CliHostCfg>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</_CliHostCfg>
      <_CliHostDir>$([System.IO.Path]::Combine('$(ArtifactsPath)', 'bin', 'Nullean.Argh.Tests.CliHost', '$(_CliHostCfg)'))\</_CliHostDir>
    </PropertyGroup>
    <ItemGroup>
      <_CliHostFiles Include="$(_CliHostDir)*.*" Exclude="$(_CliHostDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliHostFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_CliHostFiles)' != ''" />
  </Target>


  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
