<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TUnit test projects are self-hosting Microsoft.Testing.Platform executables -->
    <OutputType>Exe</OutputType>
    <!-- assertions are AwesomeAssertions; do not bring TUnit's own Assert.That into scope -->
    <TUnitAssertionsImplicitUsings>false</TUnitAssertionsImplicitUsings>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Argh.InternalsVisibleTo.Repro.Tests</AssemblyName>
    <RootNamespace>Argh.InternalsVisibleTo.Repro.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Nullean.Argh\Nullean.Argh.csproj" />
    <ProjectReference Include="..\CliApp\CliApp.csproj" />
    <ProjectReference Include="..\..\..\src\Nullean.Argh.Generator\Nullean.Argh.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
